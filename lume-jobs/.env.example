# Lume jobs backend — copy the values you want into the repo-root .env.production
# (the file docker-compose reads). All are optional; sensible defaults apply.

# Team login for the /portal admin (CHANGE THESE before going live):
LUME_JOBS_USER=lume
LUME_JOBS_PASS=change-this-password

# Random string used to sign session cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUME_JOBS_SECRET=

# Lead notifications: every application/inquiry is emailed here (comma-separated).
LUME_NOTIFY_EMAILS=josh@lumesp.com,ryan@lumesp.com
# Email is sent via Resend, REUSING the RESEND_API_KEY the main app already has in
# .env.production. The sender is a LUME address (these are lumesp.com leads) — NOT
# the shared recruitersos EMAIL_FROM. Default below; lumesp.com must be a verified
# sending domain in Resend (add the SPF/DKIM records Resend gives you).
LUME_EMAIL_FROM=Lume Search Partners <no-reply@lumesp.com>
# Optional Web3Forms fallback if you don't use Resend:
LUME_WEB3FORMS_KEY=

# --- OS Text (taltxt) bridge ---------------------------------------------------
# Push every SMS-opted-in applicant into the OS Text SMS app so consented numbers
# flow into an outreach campaign, not just an email. The URL below is the internal
# Docker service address (already set as a default in docker-compose.yml, so you
# normally only set the secret). Turn the bridge ON by setting the secret to the
# SAME value as taltxt's INGEST_SECRET (money-maker-sms/.env.production). Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OS_TEXT_INGEST_URL=http://taltxt:3000/api/ingest/opt-in
OS_TEXT_INGEST_SECRET=
# Optional: land opt-ins in a specific campaign id. Leave blank to use the default
# "Website Opt-Ins" campaign (auto-created as a DRAFT the first time a number arrives).
OS_TEXT_CAMPAIGN_ID=
